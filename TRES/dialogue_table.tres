[sub_resource type="Resource" id="line_tut_h0_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Stop! What are you doing!? Ah~ that feels so weird, nn..."
text_ja = "やめて！何するの！？あ〜変な感じ、ん…"

[sub_resource type="Resource" id="entry_tut_h0"]
script = ExtResource("2_entry")
id = "tut_h_stage_0"
lines = Array[ExtResource("3_line")]([SubResource("line_tut_h0_1")])

[sub_resource type="Resource" id="line_tut_h1_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Nn... why... draining my life but it feels so good... ah..."
text_ja = "ん…なんで…はぁ…命が削られるのに気持ちいい…あ…"

[sub_resource type="Resource" id="entry_tut_h1"]
script = ExtResource("2_entry")
id = "tut_h_stage_1"
lines = Array[ExtResource("3_line")]([SubResource("line_tut_h1_1")])

[sub_resource type="Resource" id="line_tut_h2_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Nn... ah... nn... I can't... ah..."
text_ja = "ん…ぁ…ん…だめ…ぁ…"

[sub_resource type="Resource" id="entry_tut_h2"]
script = ExtResource("2_entry")
id = "tut_h_stage_2"
lines = Array[ExtResource("3_line")]([SubResource("line_tut_h2_1")])

[sub_resource type="Resource" id="line_tut_h3_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...So much is going in... ah~ nn..."
text_ja = "……いっぱい入ってくる…あ〜ん…"

[sub_resource type="Resource" id="entry_tut_h3"]
script = ExtResource("2_entry")
id = "tut_h_stage_3"
lines = Array[ExtResource("3_line")]([SubResource("line_tut_h3_1")])

[sub_resource type="Resource" id="line_lvl01_gate_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Oh no—there's a man standing in front of the energy barrier..."
text_ja = "まずい…エネルギーバリアの前に男が立ってる…"

[sub_resource type="Resource" id="line_lvl01_gate_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I remember him. He's security. How am I supposed to get his clearance to shut this thing down?"
text_ja = "確か警備の人だ。どうやって権限をもらって、このバリアを止めればいいの？"

[sub_resource type="Resource" id="line_lvl01_gate_3"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...He's not charging at me. Looks like he hasn't turned into a monster."
text_ja = "…こっちに突進してこない。まだモンスター化してないみたい。"

[sub_resource type="Resource" id="line_lvl01_gate_4"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "But... he looks like he's in pain."
text_ja = "でも…苦しそう。"

[sub_resource type="Resource" id="line_lvl01_gate_5"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Either way, maybe I can talk to him—ask him to help shut down the barrier..."
text_ja = "とにかく話しかけて、バリアを止めるのを頼んでみよう…"

[sub_resource type="Resource" id="entry_lvl01_gate_before"]
script = ExtResource("2_entry")
id = "lvl01_gate_before"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl01_gate_1"), SubResource("line_lvl01_gate_2"), SubResource("line_lvl01_gate_3"), SubResource("line_lvl01_gate_4"), SubResource("line_lvl01_gate_5")])

[sub_resource type="Resource" id="line_lvl01_start_door_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I need to find the way home, quick..."
text_ja = "早く帰り道を見つけなきゃ…"

[sub_resource type="Resource" id="entry_lvl01_start_door"]
script = ExtResource("2_entry")
id = "lvl01_start_door"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl01_start_door_1")])

[sub_resource type="Resource" id="line_lvl02_01_bl_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I should keep heading home... Still a ways to go."
text_ja = "このまま帰り道を進もう…まだ先は長い。"

[sub_resource type="Resource" id="entry_lvl02_01_bl"]
script = ExtResource("2_entry")
id = "lvl02_01_bl_door"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl02_01_bl_1")])

[sub_resource type="Resource" id="line_lvl02_04_yellow_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "What happened here? This looks nothing like I remember..."
text_ja = "ここ…どうなってるの？記憶の中の様子と全然違う…"

[sub_resource type="Resource" id="entry_lvl02_04_yellow"]
script = ExtResource("2_entry")
id = "lvl02_04_yellow_enter"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl02_04_yellow_1")])

[sub_resource type="Resource" id="line_lvl02_04_gate_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...That woman ahead looks like she's asking for help..."
text_ja = "…前の女の人が助けを求めてる顔をしてる…"

[sub_resource type="Resource" id="line_lvl02_04_gate_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I should talk to her."
text_ja = "話しかけてみよう。"

[sub_resource type="Resource" id="entry_lvl02_04_gate_before"]
script = ExtResource("2_entry")
id = "lvl02_04_gate_before"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl02_04_gate_1"), SubResource("line_lvl02_04_gate_2")])

[sub_resource type="Resource" id="line_lvl03_01_l_door_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "What was that room just now... I need to find a way out, quick..."
text_ja = "さっきの部屋は一体……早く出口を見つけなきゃ…"

[sub_resource type="Resource" id="entry_lvl03_01_l_door"]
script = ExtResource("2_entry")
id = "lvl03_01_l_door"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl03_01_l_door_1")])

[sub_resource type="Resource" id="line_lvl03_05_s1a"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "That person ahead has such a creepy look in their eyes... but they're not chasing me."
text_ja = "前の人の目つきが不気味…でも追いかけてこない。"

[sub_resource type="Resource" id="line_lvl03_05_s1b"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Don't tell me... they want me to do that thing too...?"
text_ja = "まさか…また、あのことを要求されるの…？"

[sub_resource type="Resource" id="entry_lvl03_05_story1"]
script = ExtResource("2_entry")
id = "lvl03_05_story1"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl03_05_s1a"), SubResource("line_lvl03_05_s1b")])

[sub_resource type="Resource" id="line_lvl03_06_s2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Nooo! Run!"
text_ja = "やめて！逃げなきゃ！"

[sub_resource type="Resource" id="entry_lvl03_06_story2"]
script = ExtResource("2_entry")
id = "lvl03_06_story2"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl03_06_s2")])

[sub_resource type="Resource" id="line_lvl03_06_s3"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Aaaahhh! I have no choice—jump down!!!"
text_ja = "うわあああっ！下に跳ぶしかない！！！"

[sub_resource type="Resource" id="entry_lvl03_06_story3"]
script = ExtResource("2_entry")
id = "lvl03_06_story3"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl03_06_s3")])

[sub_resource type="Resource" id="line_lvl03_07_s1a"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...I... think I just fell from somewhere really high."
text_ja = "……私……さっき、すごく高いところから落ちた気がする。"

[sub_resource type="Resource" id="line_lvl03_07_s1b"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...My head feels a little dizzy..."
text_ja = "……頭が少しぼんやりする…"

[sub_resource type="Resource" id="line_lvl03_07_s1c"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "My body feels so light... and a little warm..."
text_ja = "体がすごく軽い…それに、少し熱い…"

[sub_resource type="Resource" id="line_lvl03_07_s1d"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "It's a heat... like burning desire."
text_ja = "これは……欲に焼かれるような熱。"

[sub_resource type="Resource" id="entry_lvl03_07_story1"]
script = ExtResource("2_entry")
id = "lvl03_07_story1"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl03_07_s1a"), SubResource("line_lvl03_07_s1b"), SubResource("line_lvl03_07_s1c"), SubResource("line_lvl03_07_s1d")])

[sub_resource type="Resource" id="line_lvl03_07_s2a"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "These people... when did they get here?"
text_ja = "この人たち……いつからここに？"

[sub_resource type="Resource" id="line_lvl03_07_s2b"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "It looks like they want to do something to me..."
text_ja = "私に、何かしようとしているみたい…"

[sub_resource type="Resource" id="entry_lvl03_07_story2"]
script = ExtResource("2_entry")
id = "lvl03_07_story2"
lines = Array[ExtResource("3_line")]([SubResource("line_lvl03_07_s2a"), SubResource("line_lvl03_07_s2b")])

[sub_resource type="Resource" id="line_lvl03_07_s3a"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I don't want to struggle anymore... it actually feels pretty good."
text_ja = "もう抵抗したくない…実は、けっこう気持ちいい。"

[sub_resource type="Resource" id="line_lvl03_07_s3b"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "As long as I..."
text_ja = "私が…"

[sub_resource type="Resource" id="line_lvl03_07_s3c"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "As long as..."
text_ja = "ただ…"

[sub_resource type="Resource" id="line_lvl03_07_s3d"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I follow the pleasure in my body and enjoy climax..."
text_ja = "体の快感に身を任せて、イキを楽しめば…"

[sub_resource type="Resource" id="line_lvl03_07_s3e"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I..."
text_ja = "私…"

[sub_resource type="Resource" id="line_lvl03_07_s3f"]
script = ExtResource("3_line")
speaker_en = "Me"
