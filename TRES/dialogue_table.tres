[ext_resource type="Script" uid="uid://dntlov5txhioo" path="res://GD/dialogue_table.gd" id="1_table"]
[ext_resource type="Script" uid="uid://b01xmcsi3u4fb" path="res://GD/dialogue_entry.gd" id="2_entry"]
[ext_resource type="Script" uid="uid://bc68g136ie88y" path="res://GD/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="line_tut00_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...I dozed off working overtime and had a weird dream—everyone in the office wanted to violate me..."
text_ja = "……残業してうたた寝したら、変な夢を見た。オフィスのみんなが私を犯そうとして…"

[sub_resource type="Resource" id="line_tut00_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "My head and body still feel floaty... I should save the files on my PC and come back tomorrow."
text_ja = "頭も体もふわふわする……とりあえずパソコンのデータを保存して、続きは明日にしよう。"

[sub_resource type="Resource" id="entry_tut00"]
script = ExtResource("2_entry")
id = "tut_00_move"
lines = Array[ExtResource("3_line")]([SubResource("line_tut00_1"), SubResource("line_tut00_2")])

[sub_resource type="Resource" id="line_tut01_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "There's a height difference ahead... I wonder when they'll ever fix this place..."
text_ja = "先に段差がある……いつになったら直るんだろう…"

[sub_resource type="Resource" id="line_tut01_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I have to hop every time I go in and out of here..."
text_ja = "ここを出入りするたびに、毎回ジャンプしないと…"

[sub_resource type="Resource" id="entry_tut01"]
script = ExtResource("2_entry")
id = "tut_01_jump"
lines = Array[ExtResource("3_line")]([SubResource("line_tut01_1"), SubResource("line_tut01_2")])

[sub_resource type="Resource" id="line_tut02_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Weird... I don't remember the desks being arranged like this."
text_ja = "おかしい……ここのデスク、こんな置き方だったっけ？"

[sub_resource type="Resource" id="line_tut02_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I'll try climbing down."
text_ja = "降りてみよう。"

[sub_resource type="Resource" id="entry_tut02"]
script = ExtResource("2_entry")
id = "tut_02_desk"
lines = Array[ExtResource("3_line")]([SubResource("line_tut02_1"), SubResource("line_tut02_2")])

[sub_resource type="Resource" id="line_tut03_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "The whole atmosphere feels wrong... just like that dream..."
text_ja = "空気が変……さっきの夢と同じ…"

[sub_resource type="Resource" id="line_tut03_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I can still dash a little. I need to get home."
text_ja = "まだ少しダッシュできる。早く帰ろう。"

[sub_resource type="Resource" id="entry_tut03"]
script = ExtResource("2_entry")
id = "tut_03_dash"
lines = Array[ExtResource("3_line")]([SubResource("line_tut03_1"), SubResource("line_tut03_2")])

[sub_resource type="Resource" id="line_tut04_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "That person up ahead... a coworker from another section? Why is he still here?"
text_ja = "あそこにいるの……他課の同僚？どうしてまだいるの？"

[sub_resource type="Resource" id="line_tut04_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...He looks weird. I've got a bad feeling. Better dash past him when I get close."
text_ja = "……様子がおかしい。嫌な予感がする。近づいたらダッシュで通り過ぎよう。"

[sub_resource type="Resource" id="entry_tut04"]
script = ExtResource("2_entry")
id = "tut_04_enemy"
lines = Array[ExtResource("3_line")]([SubResource("line_tut04_1"), SubResource("line_tut04_2")])

[sub_resource type="Resource" id="line_tut05_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "...Just like the dream!"
text_ja = "……さっきの夢と同じ！"

[sub_resource type="Resource" id="line_tut05_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "If you get caught, it turns into H—HP drains while it feels good, and the more aroused you get, the harder it is to resist."
text_ja = "捕まったらHになる。HPが減るのに気持ちよくて、興奮するほど抗えなくなる。"

[sub_resource type="Resource" id="line_tut05_3"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "That fluid they pumped into me at the end... I should wash it off soon."
text_ja = "最後に体に注がれた液体……早く洗い流さないと。"

[sub_resource type="Resource" id="entry_tut05"]
script = ExtResource("2_entry")
id = "tut_05_after_h"
lines = Array[ExtResource("3_line")]([SubResource("line_tut05_1"), SubResource("line_tut05_2"), SubResource("line_tut05_3")])

[sub_resource type="Resource" id="line_tut05b_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "I don't want to look back..."
text_ja = "もう振り返りたくない…"

[sub_resource type="Resource" id="entry_tut05b"]
script = ExtResource("2_entry")
id = "tut_05b_no_return"
lines = Array[ExtResource("3_line")]([SubResource("line_tut05b_1")])

[sub_resource type="Resource" id="line_tut05c_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "The first-aid kits and mineral water will respawn after I change scenes. I can come back for them later."
text_ja = "救急箱とミネラルウォーターはシーンを切り替えたら復活する。あとでまた取りに来ればいい。"

[sub_resource type="Resource" id="entry_tut05c"]
script = ExtResource("2_entry")
id = "tut_05c_refill"
lines = Array[ExtResource("3_line")]([SubResource("line_tut05c_1")])

[sub_resource type="Resource" id="line_tut06_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "There's a vending machine ahead... It says \"~Insert Semen~\"."
text_ja = "先に自販機がある……「～Semenを投入してください～」って書いてある。"

[sub_resource type="Resource" id="line_tut06_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "When did they change that...? So can I trade what I just got... for something?"
text_ja = "いつからこうなったの……じゃあさっきの……あれで何か換えるの？"

[sub_resource type="Resource" id="entry_tut06"]
script = ExtResource("2_entry")
id = "tut_06_shop"
lines = Array[ExtResource("3_line")]([SubResource("line_tut06_1"), SubResource("line_tut06_2")])

[sub_resource type="Resource" id="line_tut07_1"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Why does the exit look like this...? What on earth is going on?"
text_ja = "出口のドアがこんな姿に……一体どうなってるの？"

[sub_resource type="Resource" id="line_tut07_2"]
script = ExtResource("3_line")
speaker_en = "Me"
speaker_ja = "私"
show_heroine_portrait = true
text_en = "Whatever. I don't want to look back—I just want to go home."
text_ja = "もういい。振り返りたくない。ただ早く帰りたい。"

[sub_resource type="Resource" id="entry_tut07"]
script = ExtResource("2_entry")
id = "tut_07_door"
lines = Array[ExtResource("3_line")]([SubResource("line_tut07_1"), SubResource("line_tut07_2")])

[sub_resource type="Resource" id="line_story_1"]
script = ExtResource("3_line")
speaker_en = "Heroine"
speaker_ja = "ヒロイン"
show_heroine_portrait = true
text_en = "A new area... Something feels off."
text_ja = "新しいエリア……なんだか様子がおかしい。"

[sub_resource type="Resource" id="line_story_2"]
script = ExtResource("3_line")
speaker_en = ""
speaker_ja = ""
show_heroine_portrait = false
text_en = "(Story triggers play once when you enter the zone.)"
text_ja = "（ストーリートリガーはエリア進入時に一度だけ再生されます。）"

[sub_resource type="Resource" id="entry_story"]
